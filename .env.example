# Copy to .env for local development. Never commit .env.
# These are local-only dev placeholders, not real secrets.

# Postgres owner role (migrations only; bypasses RLS)
POSTGRES_USER=ticketforge
POSTGRES_PASSWORD=ticketforge_dev
POSTGRES_DB=ticketforge
POSTGRES_PORT=5433

# Restricted role the API connects as (RLS enforced)
APP_DB_USER=ticketforge_app
APP_DB_PASSWORD=ticketforge_app_dev

# Connection strings used by the Go programs (host is localhost when running outside Docker).
# API: restricted role. Migrations: owner role.
DATABASE_URL=postgres://ticketforge_app:ticketforge_app_dev@localhost:5433/ticketforge?sslmode=disable
MIGRATE_DATABASE_URL=postgres://ticketforge:ticketforge_dev@localhost:5433/ticketforge?sslmode=disable

# Signs access tokens. Must be at least 32 bytes. This is a local-only placeholder;
# generate a real one for any shared environment, e.g. in PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=dev-only-placeholder-change-me-0123456789abcdef

REDIS_PORT=6379

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
